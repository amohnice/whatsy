# LOCAL DEV: leave this unset. Requests go to /api and vite.config.js proxies
# them to http://localhost:4000.

# PRODUCTION (Vercel): set to the backend project's origin, no trailing slash.
# Vite inlines this at BUILD time, so changing it needs a redeploy.
# VITE_API_URL=https://whatsy-backend.vercel.app
