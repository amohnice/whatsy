# Copy to .env and fill in. .env is gitignored; this file is NOT — never put a
# real key or password here.

# Required for the real Claude API calls. Server-side only — never sent to the client.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Model used for all Claude calls.
ANTHROPIC_MODEL=claude-opus-5

# MongoDB Atlas connection string.
#   - Keep the /whatsy path segment; without it mongoose connects to a db named "test".
#   - Percent-encode the password if it contains @ # / : ? & % (@ -> %40, etc).
#   - Atlas Network Access must allow 0.0.0.0/0 for Vercel (no static egress IPs).
# If unset or unreachable the app falls back to an in-memory store, which is fine
# locally but loses all data on every restart.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/whatsy?retryWrites=true&w=majority

# Optional, local-dev only. Some machines hand Node a loopback DNS resolver with
# nothing listening, which breaks mongodb+srv:// SRV lookups (symptom:
# "querySrv ECONNREFUSED" even though nslookup works). Not needed on Vercel.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Production only. Comma-separated list of allowed browser origins, i.e. the
# frontend's Vercel URL. Unset = allow all.
# CORS_ORIGIN=https://whatsy.vercel.app

# Escape hatch: on Vercel a set-but-unreachable MONGODB_URI fails loudly rather
# than silently running without persistence. Set to 1 to allow the fallback.
# ALLOW_MEMORY_FALLBACK=1

PORT=4000
