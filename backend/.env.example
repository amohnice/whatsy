# Copy to .env and fill in. .env is gitignored; this file is NOT — never put a
# real key here.

# Required for the real Claude API calls. Server-side only — never sent to the client.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Model used for all Claude calls.
ANTHROPIC_MODEL=claude-opus-5

# Optional. If unreachable/unset, the app falls back to an in-memory store
# behind the same interface and still runs fully offline.
MONGODB_URI=mongodb://127.0.0.1:27017/whatsy

PORT=4000
